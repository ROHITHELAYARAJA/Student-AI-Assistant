# Copy to backend/.env. Keep credentials on the server only.
AWS_REGION=YOUR_SELECTED_AWS_REGION
AWS_BEARER_TOKEN_BEDROCK=YOUR_BEDROCK_API_KEY
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
PORT=5000
HOST=127.0.0.1
# Production requires HTTPS, NODE_ENV=production and an exact public origin.
# APP_ORIGINS=https://your-domain.example
# BLAST_DATA_DIR=/persistent/private/storage
