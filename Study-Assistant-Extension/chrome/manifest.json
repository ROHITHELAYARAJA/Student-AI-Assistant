{
  "manifest_version": 3,
  "name": "Study Assistant AI",
  "version": "1.0",
  "description": "AI-powered study assistant. Select text on any page and apply 100 learning tools instantly.",

  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],

  "action": {
    "default_title": "Open Study Assistant"
  },

  "side_panel": {
    "default_path": "side_panel.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "host_permissions": [
    "http://localhost:8080/*",
    "<all_urls>"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
