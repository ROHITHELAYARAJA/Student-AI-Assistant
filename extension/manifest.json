{
  "manifest_version": 3,
  "name": "Plein AI Study Assistant",
  "version": "2.0.0",
  "description": "High-performance AI study assistant with 100 features and dynamic React components.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "action": {
    "default_title": "Open Plein Study Assistant"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "favicon.svg"
  },
  "host_permissions": [
    "http://localhost:5000/*",
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
